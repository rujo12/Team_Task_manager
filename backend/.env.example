# ============================================================================
# ENVIRONMENT CONFIGURATION FOR TEAM TASK MANAGER BACKEND
# ============================================================================
# Copy this file to .env and fill in the values for your environment

# ============================================================================
# SECURITY
# ============================================================================

# Django secret key (generate a strong one for production)
# Command: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-in-production

# Debug mode (False in production)
DEBUG=True

# Allowed hosts (comma-separated for production)
ALLOWED_HOSTS=localhost,127.0.0.1

# Trusted origins for CSRF in production (include scheme)
CSRF_TRUSTED_ORIGINS=https://your-backend.up.railway.app

# ============================================================================
# DATABASE
# ============================================================================

# Development: SQLite (default)
# DATABASE_URL=sqlite:///db.sqlite3

# Production: PostgreSQL
# DATABASE_URL=postgresql://username:password@localhost:5432/team_task_manager
# Example Railway URL: postgresql://user:pass@containers.railway.app:7582/railway
DATABASE_URL=sqlite:///db.sqlite3

# ============================================================================
# JWT CONFIGURATION
# ============================================================================

# JWT secret key (can be same as SECRET_KEY or different)
JWT_SECRET_KEY=your-jwt-secret-key-here

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Frontend origins (comma-separated)
# Development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=False

# Production (add your frontend domain)
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================================================
# LOGGING
# ============================================================================
# Using Django's default logging for MVP development
# - Errors and warnings are visible
# - SQL queries logged only when needed for debugging
# - Clean console output during development

# ============================================================================
# EMAIL (Optional)
# ============================================================================

# Email configuration for notifications (not implemented in MVP)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# ============================================================================
# DEPLOYMENT SPECIFIC
# ============================================================================

# Railway/Heroku specific
# PORT=8000
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info

# HTTPS/security defaults (recommended True in production)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
USE_X_FORWARDED_HOST=True
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
